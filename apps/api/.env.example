# Copy to .env and fill in values. Generate JWT_SECRET with: openssl rand -hex 32
# Values are UNQUOTED on purpose: Docker's env-file parser keeps surrounding
# quotes literally, so quoting would break e.g. JWT_EXPIRES_IN inside a container.
DATABASE_URL=mysql://root:root@localhost:3306/house_management
# Optional — required only for `prisma migrate diff --from-migrations` /
# `prisma migrate dev`. Create a throwaway MySQL database and point here.
# SHADOW_DATABASE_URL=mysql://root:root@localhost:3306/house_management_shadow
PORT=3001
JWT_SECRET=
JWT_EXPIRES_IN=30d
WEB_URL=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=House Management <no-reply@house.local>
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin
# optional — enables the email-based password-reset flow for the admin account
SEED_ADMIN_EMAIL=
