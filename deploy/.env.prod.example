# Production environment for the full single-server Vultr deployment.
#
# Copy to deploy/.env.prod on the server and fill in REAL values:
#   cp deploy/.env.prod.example deploy/.env.prod
#
# deploy/.env.prod is gitignored — never commit it.
# Values are UNQUOTED on purpose (Docker's env-file parser keeps quotes literally).

# --- Database ---------------------------------------------------------------
# Use hex so the values are URL-safe when Compose builds DATABASE_URL.
# Generate each password with: openssl rand -hex 24
MYSQL_ROOT_PASSWORD=replace-with-random-hex
MYSQL_DATABASE=house_management
MYSQL_USER=house_app
MYSQL_PASSWORD=replace-with-different-random-hex

# --- Auth --------------------------------------------------------------------
# Generate with:  openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=30d

# --- Public domains / TLS ----------------------------------------------------
# Create DNS A records for both domains pointing to the Vultr reserved IP.
APP_DOMAIN=house.example.com
API_DOMAIN=api.house.example.com
TLS_EMAIL=admin@example.com
# Absolute public frontend URL used in password-reset emails.
WEB_URL=https://house.example.com

# --- Email (SMTP) ------------------------------------------------------------
# In production use a real SMTP provider (e.g. Amazon SES, Resend, Mailgun,
# Gmail app password). MailHog is dev-only and is NOT part of this stack.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=House Management <no-reply@your-domain.com>

# --- Initial admin account (seeded once, idempotent) -------------------------
SEED_ADMIN_USERNAME=admin
# Use a strong password; change it after first login.
SEED_ADMIN_PASSWORD=change-me-after-first-login
# Optional — set to enable the email-based password-reset flow for admin.
SEED_ADMIN_EMAIL=
